# ══ FDE 售前智能体 配置模板 ══
# 复制为 .env 后按需修改；不带 FDE_ 前缀的 key 也会被自动识别。

# ── 方式一（推荐）：直接指定任意 OpenAI 兼容端点 ──
# 智谱 GLM 示例：
FDE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FDE_LLM_API_KEY=你的APIKey
FDE_LLM_MODEL=glm-4.7
FDE_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FDE_EMBEDDING_API_KEY=你的APIKey
FDE_EMBEDDING_MODEL=embedding-3

# ── 方式二：只填某家的 key，自动识别提供方与默认模型 ──
# ZHIPUAI_API_KEY=          # 智谱（glm-4.7 + embedding-3）
# DEEPSEEK_API_KEY=         # DeepSeek（deepseek-chat；注意其无 embedding 接口，需另配 embedding）
# DASHSCOPE_API_KEY=        # 阿里云百炼（qwen-plus + text-embedding-v3）
# MOONSHOT_API_KEY=         # 月之暗面（moonshot-v1-32k；无 embedding，需另配）
# OPENAI_API_KEY=           # OpenAI（gpt-4o + text-embedding-3-small）

# ── 本地 vLLM/Ollama 等 OpenAI 兼容服务 ──
# FDE_LLM_BASE_URL=http://localhost:8000/v1
# FDE_LLM_API_KEY=EMPTY
# FDE_LLM_MODEL=Qwen2.5-32B-Instruct
# FDE_EMBEDDING_BASE_URL=http://localhost:8001/v1
# FDE_EMBEDDING_API_KEY=EMPTY
# FDE_EMBEDDING_MODEL=bge-m3

# ── 知识源路径（默认：项目内置 SOP 副本 + FDE研究报告\md 章节源 + FDE 实战课课程稿[如存在]，一般无需修改） ──
# FDE_SOP_PATH=knowledge\FDE课程关键经验与客户洞察-项目全生命周期SOP.md
# FDE_REPORT_MD_DIR=C:\Users\Administrator\Desktop\FDE研究报告\md
# FDE_REPORT_PDF=C:\Users\Administrator\Desktop\FDE研究报告\FDE全景研究报告-模式案例与落地操作手册.pdf
# FDE_COURSE_DIR=C:\Users\Administrator\Desktop\FDE-PPT\md
# FDE_DATA_DIR=data
